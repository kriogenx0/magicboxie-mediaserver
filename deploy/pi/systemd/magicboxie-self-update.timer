# Installed by scripts/pi-setup.sh. Checks main a few minutes after boot and
# every night. Persistent=true runs a check missed while the Pi was off.
[Unit]
Description=Run the MagicBoxie media server self-update daily

[Timer]
OnBootSec=5min
OnCalendar=*-*-* 04:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
